# Copy this file to .env.local and fill in YOUR values.
# .env.local is git-ignored. Never commit real credentials.
# None of these variables use the NEXT_PUBLIC_ prefix, so none reach the browser.

# PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/ev_charging_analytics

# Set to true only if your PostgreSQL server requires SSL (e.g. a hosted database)
DATABASE_SSL=false

# "demo" labels all readings as synthetic test data in the UI. Use "production" only for real telemetry.
DATA_MODE=demo
